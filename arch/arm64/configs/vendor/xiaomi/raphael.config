# Platform
CONFIG_MACH_XIAOMI_RAPHAEL=y
CONFIG_BUILD_ARM64_DT_OVERLAY=y
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y
CONFIG_FRAME_WARN=4096

# Filesystems (EROFS / exFAT / F2FS Unicode)
CONFIG_EROFS_FS=y
CONFIG_EXFAT_FS=y
CONFIG_UNICODE=y
# CONFIG_UNICODE_NORMALIZATION_SELFTEST is not set

# Wi-Fi (QCACLD)
CONFIG_QCA_CLD_WLAN=y

# Pstore / Ramoops
CONFIG_CMDLINE="ramoops_memreserve=4M"
CONFIG_CMDLINE_EXTEND=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_SQ=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_OOPS=y
CONFIG_MTD_BLOCK2MTD=y

# Audio (NXP TFA9874 SmartPA + Speaker ID)
CONFIG_SND_SOC_TFA9874=y
CONFIG_HAS_IOMEM=y
CONFIG_MFD_SPK_ID=y

# Display / Backlight
CONFIG_BACKLIGHT_LCD_SUPPORT=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# Pop-up Camera Motor & Hall Sensor (TI DRV8846 + AKM09970)
CONFIG_TI_DRV8846=y
CONFIG_AKM09970=y

# Touchscreen & UDFPS Fingerprint (Goodix GT9886 + Goodix Optical FOD)
# CONFIG_TOUCHSCREEN_ST is not set
CONFIG_TOUCHSCREEN_GOODIX_GTX8=y
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_GOODIX_TA=y

# Power & Charging (PM8150B + SMB1390 Charge Pump)
# CONFIG_SMB1355_SLAVE_CHARGER is not set
# CONFIG_SMB1390_CHARGE_PUMP_PSY is not set
CONFIG_SMB1390_CHARGE_PUMP=y

# Ultrasonic Proximity & SIM Tray & Trusty TEE
CONFIG_US_PROXIMITY=y
CONFIG_SIMTRAY_STATUS=y
CONFIG_TRUSTY=y
